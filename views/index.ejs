<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>UniQBank — University Question Bank</title>

  <style>

    /* =========================
       RESET
    ========================= */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;

      background: #f6f8fb;
      color: #172b4d;
      min-height: 100vh;
    }

    a {
      text-decoration: none;
    }

    button,
    input,
    select {
      font: inherit;
    }


    /* =========================
       COMMON
    ========================= */

    .container {
      width: min(1120px, calc(100% - 40px));
      margin: 0 auto;
    }


    /* =========================
       HEADER
    ========================= */

    .header {
      background: #ffffff;
      border-bottom: 1px solid #e5e9f0;

      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-inner {
      min-height: 72px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 20px;
    }

    .brand {
      display: flex;
      align-items: center;

      gap: 11px;

      color: #172b4d;
    }

    .brand-icon {
      width: 38px;
      height: 38px;

      border-radius: 9px;

      background: #172b4d;
      color: #ffffff;

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 18px;
      font-weight: 700;
    }

    .brand-name {
      font-family: Georgia, "Times New Roman", serif;

      font-size: 22px;
      font-weight: 700;

      line-height: 1;
    }

    .brand-subtitle {
      margin-top: 4px;

      color: #8a94a6;

      font-size: 11px;
    }

    .upload-button {
      display: inline-flex;
      align-items: center;

      gap: 7px;

      background: #172b4d;
      color: #ffffff;

      padding: 10px 16px;

      border-radius: 8px;

      font-size: 14px;
      font-weight: 600;

      transition:
        background 0.2s ease,
        transform 0.2s ease;
    }

    .upload-button:hover {
      background: #0f2038;

      transform: translateY(-1px);
    }


    /* =========================
       HERO
    ========================= */

    .hero {
      background: #ffffff;

      border-bottom: 1px solid #e5e9f0;
    }

    .hero-inner {
      padding: 62px 0 46px;
    }

    .eyebrow {
      display: flex;
      align-items: center;

      gap: 8px;

      color: #2563eb;

      font-size: 14px;
      font-weight: 600;

      margin-bottom: 15px;
    }

    .eyebrow-dot {
      width: 7px;
      height: 7px;

      border-radius: 50%;

      background: #2563eb;
    }

    .hero-title {
      max-width: 760px;

      font-family: Georgia, "Times New Roman", serif;

      font-size: clamp(34px, 5vw, 52px);

      line-height: 1.1;

      font-weight: 700;

      color: #172b4d;
    }

    .hero-title span {
      color: #2563eb;
    }

    .hero-description {
      max-width: 680px;

      margin-top: 18px;

      color: #657184;

      font-size: 17px;

      line-height: 1.7;
    }


    /* =========================
       SEARCH BOX
    ========================= */

    .search-box {
      margin-top: 32px;

      background: #f8fafc;

      border: 1px solid #e2e8f0;

      border-radius: 13px;

      padding: 13px;
    }

    .search-grid {
      display: grid;

      grid-template-columns:
        minmax(200px, 1fr)
        190px
        160px
        auto;

      gap: 10px;
    }

    .input-wrapper {
      position: relative;
    }

    .search-icon {
      position: absolute;

      left: 15px;
      top: 50%;

      transform: translateY(-50%);

      color: #94a3b8;

      font-size: 18px;

      pointer-events: none;
    }

    .search-input,
    .filter-select {
      width: 100%;
      height: 48px;

      background: #ffffff;

      border: 1px solid #dce2ea;

      border-radius: 8px;

      color: #172b4d;

      font-size: 14px;

      outline: none;

      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
    }

    .search-input {
      padding: 0 14px 0 42px;
    }

    .filter-select {
      padding: 0 13px;

      cursor: pointer;
    }

    .search-input::placeholder {
      color: #a1aaba;
    }

    .search-input:focus,
    .filter-select:focus {
      border-color: #2563eb;

      box-shadow:
        0 0 0 3px rgba(37, 99, 235, 0.10);
    }

    .search-button {
      height: 48px;

      border: none;

      border-radius: 8px;

      padding: 0 24px;

      background: #2563eb;

      color: #ffffff;

      font-size: 14px;

      font-weight: 600;

      cursor: pointer;

      transition:
        background 0.2s ease,
        transform 0.2s ease;
    }

    .search-button:hover {
      background: #1d4ed8;

      transform: translateY(-1px);
    }

    .clear-filters {
      display: inline-block;

      margin-top: 11px;

      padding-left: 3px;

      color: #64748b;

      font-size: 13px;
    }

    .clear-filters:hover {
      color: #172b4d;

      text-decoration: underline;
    }


    /* =========================
       NOTICES
    ========================= */

    .notice {
      margin-top: 22px;

      padding: 13px 16px;

      border-radius: 8px;

      font-size: 14px;

      line-height: 1.5;
    }

    .success {
      background: #ecfdf3;

      border: 1px solid #bbf7d0;

      color: #166534;
    }

    .error {
      background: #fef2f2;

      border: 1px solid #fecaca;

      color: #b91c1c;
    }


    /* =========================
       RESULTS
    ========================= */

    .results {
      padding: 42px 0 70px;
    }

    .results-header {
      display: flex;

      align-items: flex-end;

      justify-content: space-between;

      gap: 20px;

      margin-bottom: 22px;
    }

    .results-title {
      font-family: Georgia, "Times New Roman", serif;

      color: #172b4d;

      font-size: 25px;

      font-weight: 700;
    }

    .results-count {
      margin-top: 5px;

      color: #94a3b8;

      font-size: 13px;
    }

    .mobile-upload {
      color: #2563eb;

      font-size: 14px;

      font-weight: 600;
    }

    .mobile-upload:hover {
      text-decoration: underline;
    }


    /* =========================
       QUESTION GRID
    ========================= */

    .question-grid {
      display: grid;

      grid-template-columns:
        repeat(3, minmax(0, 1fr));

      gap: 18px;
    }

    .question-card {
      background: #ffffff;

      border: 1px solid #e2e8f0;

      border-radius: 12px;

      padding: 20px;

      min-height: 290px;

      display: flex;

      flex-direction: column;

      justify-content: space-between;

      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease;
    }

    .question-card:hover {
      border-color: #bfdbfe;

      box-shadow:
        0 8px 25px rgba(15, 23, 42, 0.06);

      transform: translateY(-2px);
    }

    .card-top {
      display: flex;

      align-items: flex-start;

      justify-content: space-between;

      gap: 10px;
    }

    .course-code {
      display: inline-flex;

      align-items: center;

      padding: 5px 9px;

      background: #eff6ff;

      color: #1d4ed8;

      border-radius: 6px;

      font-size: 12px;

      font-weight: 700;
    }

    .exam-type {
      display: inline-flex;

      align-items: center;

      padding: 5px 9px;

      background: #f8fafc;

      color: #64748b;

      border: 1px solid #e2e8f0;

      border-radius: 6px;

      font-size: 11px;

      font-weight: 600;

      white-space: nowrap;
    }

    .course-title {
      margin-top: 17px;

      font-family: Georgia, "Times New Roman", serif;

      color: #172b4d;

      font-size: 19px;

      line-height: 1.4;

      font-weight: 700;
    }

    .course-details {
      margin-top: 18px;

      display: flex;

      flex-direction: column;

      gap: 8px;
    }

    .detail-row {
      display: flex;

      align-items: center;

      gap: 7px;

      font-size: 13px;

      line-height: 1.4;
    }

    .detail-label {
      color: #94a3b8;
    }

    .detail-value {
      color: #475569;

      font-weight: 500;
    }

    .card-bottom {
      margin-top: 22px;

      padding-top: 14px;

      border-top: 1px solid #edf0f4;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 10px;
    }

    .download-count {
      color: #94a3b8;

      font-size: 12px;
    }

    .download-button {
      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 7px;

      background: #172b4d;

      color: #ffffff;

      padding: 9px 13px;

      border-radius: 7px;

      font-size: 13px;

      font-weight: 600;

      transition: background 0.2s ease;
    }

    .download-button:hover {
      background: #0f2038;
    }

    .download-icon {
      font-size: 14px;
    }


    /* =========================
       EMPTY STATE
    ========================= */

    .empty-state {
      background: #ffffff;

      border: 1px dashed #cbd5e1;

      border-radius: 12px;

      padding: 65px 20px;

      text-align: center;
    }

    .empty-icon {
      width: 54px;
      height: 54px;

      margin: 0 auto 15px;

      border-radius: 50%;

      background: #f1f5f9;

      color: #64748b;

      display: flex;

      align-items: center;

      justify-content: center;

      font-size: 21px;

      font-weight: 700;
    }

    .empty-title {
      font-family: Georgia, "Times New Roman", serif;

      color: #172b4d;

      font-size: 21px;

      font-weight: 700;
    }

    .empty-description {
      max-width: 450px;

      margin: 8px auto 0;

      color: #94a3b8;

      font-size: 14px;

      line-height: 1.6;
    }

    .empty-actions {
      margin-top: 21px;

      display: flex;

      align-items: center;

      justify-content: center;

      gap: 10px;

      flex-wrap: wrap;
    }

    .secondary-button,
    .primary-button {
      display: inline-flex;

      align-items: center;

      justify-content: center;

      padding: 10px 16px;

      border-radius: 7px;

      font-size: 13px;

      font-weight: 600;
    }

    .secondary-button {
      background: #ffffff;

      border: 1px solid #dce2ea;

      color: #475569;
    }

    .secondary-button:hover {
      background: #f8fafc;
    }

    .primary-button {
      background: #172b4d;

      color: #ffffff;
    }

    .primary-button:hover {
      background: #0f2038;
    }


    /* =========================
       PAGINATION
    ========================= */

    .pagination {
      display: flex;

      justify-content: center;

      align-items: center;

      gap: 16px;

      margin: 35px 0;
    }

    .pagination-btn {
      display: inline-block;

      padding: 10px 18px;

      border: 1px solid #ddd;

      border-radius: 6px;

      background: #ffffff;

      color: #222;

      text-decoration: none;

      font-size: 14px;

      font-weight: 500;

      transition: 0.2s ease;
    }

    .pagination-btn:hover {
      background: #f5f5f5;

      border-color: #bbb;
    }

    .pagination-page {
      font-size: 14px;

      font-weight: 600;

      color: #555;
    }


    /* =========================
       FOOTER
    ========================= */

    .footer {
      background: #ffffff;

      border-top: 1px solid #e5e9f0;
    }

    .footer-inner {
      min-height: 100px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 20px;
    }

    .footer-brand {
      font-family: Georgia, "Times New Roman", serif;

      color: #172b4d;

      font-size: 16px;

      font-weight: 700;
    }

    .footer-text {
      margin-top: 3px;

      color: #94a3b8;

      font-size: 12px;
    }

    .footer-links {
      display: flex;

      gap: 20px;
    }

    .footer-links a {
      color: #64748b;

      font-size: 13px;
    }

    .footer-links a:hover {
      color: #172b4d;
    }


    /* =========================
       TABLET
    ========================= */

    @media (max-width: 900px) {

      .search-grid {
        grid-template-columns: 1fr 1fr;
      }

      .search-button {
        width: 100%;
      }

      .question-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

    }


    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 640px) {

      .container {
        width: min(100% - 28px, 1120px);
      }

      .header-inner {
        min-height: 64px;
      }

      .brand-subtitle {
        display: none;
      }

      .brand-name {
        font-size: 20px;
      }

      .brand-icon {
        width: 35px;
        height: 35px;
      }

      .upload-button {
        padding: 9px 12px;

        font-size: 12px;
      }

      .hero-inner {
        padding: 42px 0 32px;
      }

      .hero-title {
        font-size: 35px;
      }

      .hero-description {
        font-size: 15px;
      }

      .search-box {
        margin-top: 25px;
      }

      .search-grid {
        grid-template-columns: 1fr;
      }

      .search-input,
      .filter-select,
      .search-button {
        height: 46px;
      }

      .results {
        padding: 34px 0 55px;
      }

      .results-header {
        align-items: flex-start;
      }

      .results-title {
        font-size: 22px;
      }

      .mobile-upload {
        display: none;
      }

      .question-grid {
        grid-template-columns: 1fr;

        gap: 14px;
      }

      .question-card {
        min-height: auto;
      }

      .footer-inner {
        padding: 25px 0;

        flex-direction: column;

        text-align: center;
      }

      .footer-links {
        gap: 16px;
      }

      .pagination {
        gap: 10px;

        margin: 28px 0;
      }

      .pagination-btn {
        padding: 9px 14px;

        font-size: 13px;
      }

      .pagination-page {
        font-size: 13px;
      }

    }


    /* =========================
       SMALL MOBILE
    ========================= */

    @media (max-width: 400px) {

      .upload-button {
        font-size: 0;
      }

      .upload-button span {
        font-size: 18px;
      }

      .hero-title {
        font-size: 31px;
      }

      .card-top {
        align-items: flex-start;
      }

      .exam-type {
        font-size: 10px;
      }

    }

  </style>

</head>


<body>


  <!-- =========================
       SAFE EJS VARIABLES
  ========================= -->

  <%
    const questionList =
      typeof questions !== 'undefined' && Array.isArray(questions)
        ? questions
        : [];

    const departmentList =
      typeof departments !== 'undefined' && Array.isArray(departments)
        ? departments
        : [];

    const semesterList =
      typeof semesters !== 'undefined' && Array.isArray(semesters)
        ? semesters
        : [];

    const activeFilters =
      typeof filters !== 'undefined' && filters
        ? filters
        : {};

    const currentPage =
      Number.isInteger(Number(page)) && Number(page) >= 1
        ? Number(page)
        : 1;

    const pageLimit =
      Number.isInteger(Number(limit)) && Number(limit) > 0
        ? Number(limit)
        : 12;
  %>


  <!-- =========================
       HEADER
  ========================= -->

  <header class="header">

    <div class="container header-inner">

      <a href="/" class="brand">

        <div class="brand-icon">
          U
        </div>

        <div>

          <div class="brand-name">
            UniQBank
          </div>

          <div class="brand-subtitle">
            University Question Bank
          </div>

        </div>

      </a>


      <a href="/upload" class="upload-button">

        <span>+</span>

        <span>Upload Paper</span>

      </a>

    </div>

  </header>


  <!-- =========================
       HERO
  ========================= -->

  <section class="hero">

    <div class="container hero-inner">

      <div class="eyebrow">

        <span class="eyebrow-dot"></span>

        <span>
          Open for everyone
        </span>

      </div>


      <h1 class="hero-title">

        Find your university

        <span>
          question papers
        </span>

        easily.

      </h1>


      <p class="hero-description">

        Search previous question papers by course, department, or semester.
        Download what you need or upload a paper to help other students.

      </p>


      <!-- =========================
           SEARCH
      ========================= -->

      <form
        action="/"
        method="GET"
        class="search-box"
      >

        <div class="search-grid">


          <!-- Keyword -->

          <div class="input-wrapper">

            <span class="search-icon">
              ⌕
            </span>

            <input
              type="text"
              name="keyword"
              value="<%= activeFilters.keyword || '' %>"
              placeholder="Search course, subject, code..."
              class="search-input"
            >

          </div>


          <!-- Department -->

          <select
            name="department"
            class="filter-select"
          >

            <option value="">
              All Departments
            </option>


            <% departmentList.forEach(function(dept) { %>

              <option
                value="<%= dept %>"
                <%= String(activeFilters.department || '') === String(dept) ? 'selected' : '' %>
              >

                <%= dept %>

              </option>

            <% }); %>

          </select>


          <!-- Semester -->

          <select
            name="semester"
            class="filter-select"
          >

            <option value="">
              All Semesters
            </option>


            <% semesterList.forEach(function(sem) { %>

              <option
                value="<%= sem %>"
                <%= String(activeFilters.semester || '') === String(sem) ? 'selected' : '' %>
              >

                <%= sem %>

              </option>

            <% }); %>

          </select>


          <!-- Search Button -->

          <button
            type="submit"
            class="search-button"
          >

            Search

          </button>

        </div>


        <!-- Clear Filters -->

        <% if (
          activeFilters.department ||
          activeFilters.semester ||
          activeFilters.keyword
        ) { %>

          <a
            href="/"
            class="clear-filters"
          >

            Clear all filters →

          </a>

        <% } %>

      </form>

    </div>

  </section>


  <!-- =========================
       NOTICES
  ========================= -->

  <div class="container">

    <% if (typeof success !== 'undefined' && success) { %>

      <div class="notice success">

        <%= success %>

      </div>

    <% } %>


    <% if (typeof error !== 'undefined' && error) { %>

      <div class="notice error">

        <%= error %>

      </div>

    <% } %>

  </div>


  <!-- =========================
       RESULTS
  ========================= -->

  <main class="container results">


    <!-- Results Header -->

    <div class="results-header">

      <div>

        <h2 class="results-title">
          Question Papers
        </h2>

        <p class="results-count">

          <%= questionList.length %>

          <%= questionList.length === 1
            ? 'paper'
            : 'papers'
          %>

          found

        </p>

      </div>


      <a
        href="/upload"
        class="mobile-upload"
      >

        + Upload paper

      </a>

    </div>


    <!-- =========================
         EMPTY STATE
    ========================= -->

    <% if (questionList.length === 0) { %>

      <div class="empty-state">

        <div class="empty-icon">
          ?
        </div>


        <h3 class="empty-title">
          No question papers found
        </h3>


        <p class="empty-description">

          Try another search term or clear the filters.
          You can also upload the first paper for this course.

        </p>


        <div class="empty-actions">

          <a
            href="/"
            class="secondary-button"
          >

            Clear Search

          </a>


          <a
            href="/upload"
            class="primary-button"
          >

            Upload a Paper

          </a>

        </div>

      </div>


    <% } else { %>


      <!-- =========================
           QUESTION CARDS
      ========================= -->

      <div class="question-grid">


        <% questionList.forEach(function(q) { %>

          <article class="question-card">

            <div>


              <!-- Top -->

              <div class="card-top">

                <span class="course-code">
                  <%= q.course_code %>
                </span>


                <% if (q.exam_type) { %>

                  <span class="exam-type">
                    <%= q.exam_type %>
                  </span>

                <% } %>

              </div>


              <!-- Course Title -->

              <h3 class="course-title">
                <%= q.course_title %>
              </h3>


              <!-- Details -->

              <div class="course-details">


                <div class="detail-row">

                  <span class="detail-label">
                    Department:
                  </span>

                  <span class="detail-value">
                    <%= q.department %>
                  </span>

                </div>


                <div class="detail-row">

                  <span class="detail-label">
                    Semester:
                  </span>

                  <span class="detail-value">
                    <%= q.semester %>
                  </span>

                </div>


                <div class="detail-row">

                  <span class="detail-label">
                    Session:
                  </span>

                  <span class="detail-value">
                    <%= q.session_year %>
                  </span>

                </div>


              </div>

            </div>


            <!-- Card Bottom -->

            <div class="card-bottom">


              <span class="download-count">

                <%= Number(q.download_count) || 0 %>

                <%= Number(q.download_count) === 1
                  ? 'download'
                  : 'downloads'
                %>

              </span>


              <a
                href="/download/<%= q.id %>"
                class="download-button"
              >

                Download

                <span class="download-icon">
                  ↓
                </span>

              </a>

            </div>

          </article>

        <% }); %>


      </div>


      <!-- =========================
           PAGINATION
      ========================= -->

      <% if (currentPage > 1 || questionList.length === pageLimit) { %>

        <div class="pagination">


          <% if (currentPage > 1) { %>

            <a
              href="/?page=<%= currentPage - 1 %>"
              class="pagination-btn"
            >

              ← Previous

            </a>

          <% } %>


          <span class="pagination-page">

            Page <%= currentPage %>

          </span>


          <% if (questionList.length === pageLimit) { %>

            <a
              href="/?page=<%= currentPage + 1 %>"
              class="pagination-btn"
            >

              Next →

            </a>

          <% } %>


        </div>

      <% } %>


    <% } %>


  </main>


  <!-- =========================
       FOOTER
  ========================= -->

  <footer class="footer">

