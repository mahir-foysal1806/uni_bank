<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Upload a Paper — UniQBank</title>

  <style>
    /* =========================
       RESET
    ========================= */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;

      background: #f6f8fb;
      color: #172b4d;
      min-height: 100vh;
    }

    a {
      text-decoration: none;
    }

    button,
    input,
    select {
      font: inherit;
    }


    /* =========================
       CONTAINER
    ========================= */

    .container {
      width: min(820px, calc(100% - 40px));
      margin: 0 auto;
    }


    /* =========================
       HEADER
    ========================= */

    .header {
      background: #ffffff;
      border-bottom: 1px solid #e5e9f0;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-inner {
      min-height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      color: #172b4d;
    }

    .brand-icon {
      width: 38px;
      height: 38px;
      border-radius: 9px;
      background: #172b4d;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      font-weight: 700;
    }

    .brand-name {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 22px;
      font-weight: 700;
      line-height: 1;
    }

    .brand-subtitle {
      margin-top: 4px;
      color: #8a94a6;
      font-size: 11px;
    }

    .back-link {
      color: #64748b;
      font-size: 13px;
      font-weight: 500;
      transition: color 0.2s ease;
    }

    .back-link:hover {
      color: #172b4d;
    }


    /* =========================
       MAIN
    ========================= */

    .main {
      padding: 52px 0 70px;
    }

    .intro {
      margin-bottom: 28px;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #2563eb;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 12px;
    }

    .eyebrow-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #2563eb;
    }

    .title {
      font-family: Georgia, "Times New Roman", serif;
      color: #172b4d;
      font-size: clamp(30px, 5vw, 42px);
      line-height: 1.15;
      font-weight: 700;
    }

    .description {
      max-width: 650px;
      margin-top: 12px;
      color: #64748b;
      font-size: 15px;
      line-height: 1.7;
    }


    /* =========================
       ERROR MESSAGE
    ========================= */

    .error-message {
      margin-bottom: 20px;
      padding: 13px 15px;
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 8px;
      color: #b91c1c;
      font-size: 14px;
      line-height: 1.5;
    }


    /* =========================
       FORM CARD
    ========================= */

    .form-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 13px;
      padding: 25px;
    }


    /* =========================
       FORM GRID
    ========================= */

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .full-width {
      grid-column: 1 / -1;
    }

    .label {
      margin-bottom: 7px;
      color: #334155;
      font-size: 13px;
      font-weight: 600;
    }

    .required {
      color: #ef4444;
    }


    /* =========================
       INPUTS
    ========================= */

    .input,
    .select {
      width: 100%;
      height: 46px;
      padding: 0 13px;
      background: #ffffff;
      border: 1px solid #dce2ea;
      border-radius: 8px;
      color: #172b4d;
      font-size: 14px;
      outline: none;

      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
    }

    .input::placeholder {
      color: #a1aaba;
    }

    .input:focus,
    .select:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
    }

    .select {
      cursor: pointer;
    }

    .help-text {
      margin-top: 7px;
      color: #94a3b8;
      font-size: 12px;
      line-height: 1.5;
    }


    /* =========================
       FILE INPUT
    ========================= */

    .file-input {
      width: 100%;
      padding: 10px;
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
      border-radius: 8px;
      color: #64748b;
      font-size: 13px;
      cursor: pointer;

      transition:
        border-color 0.2s ease,
        background 0.2s ease;
    }

    .file-input:hover {
      border-color: #93c5fd;
      background: #f8fbff;
    }

    .file-input::file-selector-button {
      margin-right: 10px;
      padding: 8px 13px;
      border: none;
      border-radius: 6px;
      background: #172b4d;
      color: #ffffff;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }

    .file-input::file-selector-button:hover {
      background: #0f2038;
    }

    .file-help {
      margin-top: 7px;
      color: #94a3b8;
      font-size: 12px;
      line-height: 1.5;
    }


    /* =========================
       SUBMIT BUTTON
    ========================= */

    .submit-button {
      width: 100%;
      height: 48px;
      margin-top: 24px;
      border: none;
      border-radius: 8px;
      background: #2563eb;
      color: #ffffff;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;

      transition:
        background 0.2s ease,
        transform 0.2s ease;
    }

    .submit-button:hover {
      background: #1d4ed8;
      transform: translateY(-1px);
    }

    .submit-button:active {
      transform: translateY(0);
    }


    /* =========================
       INFO BOX
    ========================= */

    .info-box {
      margin-top: 16px;
      padding: 13px 15px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      color: #64748b;
      font-size: 12px;
      line-height: 1.6;
    }


    /* =========================
       FOOTER
    ========================= */

    .footer {
      border-top: 1px solid #e5e9f0;
      background: #ffffff;
    }

    .footer-inner {
      min-height: 85px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .footer-brand {
      font-family: Georgia, "Times New Roman", serif;
      color: #172b4d;
      font-size: 15px;
      font-weight: 700;
    }

    .footer-text {
      margin-top: 3px;
      color: #94a3b8;
      font-size: 11px;
    }

    .footer-link {
      color: #64748b;
      font-size: 13px;
    }

    .footer-link:hover {
      color: #172b4d;
    }


    /* =========================
       TABLET
    ========================= */

    @media (max-width: 700px) {
      .form-grid {
        grid-template-columns: 1fr;
      }

      .full-width {
        grid-column: auto;
      }
    }


    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 640px) {
      .container {
        width: min(100% - 28px, 820px);
      }

      .header-inner {
        min-height: 64px;
      }

      .brand-subtitle {
        display: none;
      }

      .brand-name {
        font-size: 20px;
      }

      .brand-icon {
        width: 35px;
        height: 35px;
      }

      .back-link {
        font-size: 12px;
      }

      .main {
        padding: 38px 0 55px;
      }

      .title {
        font-size: 32px;
      }

      .description {
        font-size: 14px;
      }

      .form-card {
        padding: 18px;
      }

      .form-grid {
        gap: 17px;
      }

      .footer-inner {
        min-height: 110px;
        flex-direction: column;
        justify-content: center;
        text-align: center;
      }
    }


    /* =========================
       SMALL MOBILE
    ========================= */

    @media (max-width: 400px) {
      .back-link {
        font-size: 0;
      }

      .back-link::before {
        content: "← Back";
        font-size: 13px;
      }

      .title {
        font-size: 29px;
      }
    }
  </style>
</head>


<body>

  <!-- =========================
       HEADER
  ========================= -->

  <header class="header">

    <div class="container header-inner">

      <!-- Brand -->

      <a href="/" class="brand">

        <div class="brand-icon">
          U
        </div>

        <div>

          <div class="brand-name">
            UniQBank
          </div>

          <div class="brand-subtitle">
            University Question Bank
          </div>

        </div>

      </a>


      <!-- Back -->

      <a href="/" class="back-link">
        ← Back to Browse
      </a>

    </div>

  </header>


  <!-- =========================
       MAIN
  ========================= -->

  <main class="container main">

    <!-- Intro -->

    <div class="intro">

      <div class="eyebrow">

        <span class="eyebrow-dot"></span>

        <span>
          Takes under a minute
        </span>

      </div>


      <h1 class="title">
        Upload a question paper
      </h1>


      <p class="description">
        No account needed. Fill in the details below and attach your file.
        Your paper will be searchable and downloadable by other students.
      </p>

    </div>


    <!-- =========================
         ERROR
    ========================= -->

    <% if (typeof error !== 'undefined' && error) { %>

      <div class="error-message">
        <%= error %>
      </div>

    <% } %>


    <!-- =========================
         FORM
    ========================= -->

    <form
      action="/upload"
      method="POST"
      enctype="multipart/form-data"
      class="form-card"
    >

      <div class="form-grid">


        <!-- =========================
             Department
        ========================= -->

        <div class="form-group">

          <label
            for="department"
            class="label"
          >
            Department
            <span class="required">*</span>
          </label>


          <input
            type="text"
            id="department"
            name="department"
            required
            autocomplete="off"
            list="departmentList"
            placeholder="Search or type department (e.g. CSE)"
            class="input"
          >


          <!-- Existing departments -->

          <datalist id="departmentList">

            <% departments.forEach(function(dept) { %>

              <option value="<%= dept %>">

            <% }); %>

          </datalist>


          <p class="help-text">
            Select an existing department or type a new one.
          </p>

        </div>


        <!-- =========================
             Semester
        ========================= -->

        <div class="form-group">

          <label
            for="semester"
            class="label"
          >
            Semester
            <span class="required">*</span>
          </label>


          <select
            id="semester"
            name="semester"
            required
            class="select"
          >

            <option
              value=""
              disabled
              selected
            >
              Select semester
            </option>


            <% semesters.forEach(function(sem) { %>

              <option value="<%= sem %>">
                <%= sem %>
              </option>

            <% }); %>

          </select>

        </div>


        <!-- =========================
             Course Code
        ========================= -->

        <div class="form-group">

          <label
            for="courseCode"
            class="label"
          >
            Course Code
            <span class="required">*</span>
          </label>


          <input
            type="text"
            id="courseCode"
            name="courseCode"
            required
            autocomplete="off"
            placeholder="e.g. CSE220"
            class="input"
          >

        </div>


        <!-- =========================
             Course Title
        ========================= -->

        <div class="form-group">

          <label
            for="courseTitle"
            class="label"
          >
            Course Title
            <span class="required">*</span>
          </label>


          <input
            type="text"
            id="courseTitle"
            name="courseTitle"
            required
            autocomplete="off"
            placeholder="e.g. Data Structures"
            class="input"
          >

        </div>


        <!-- =========================
             Exam Type
        ========================= -->

        <div class="form-group">

          <label
            for="examType"
            class="label"
          >
            Exam Type
            <span class="required">*</span>
          </label>


          <select
            id="examType"
            name="examType"
            required
            class="select"
          >

            <option
              value=""
              disabled
              selected
            >
              Select exam type
            </option>


            <% examTypes.forEach(function(type) { %>

              <option value="<%= type %>">
                <%= type %>
              </option>

            <% }); %>

          </select>

        </div>


        <!-- =========================
             Session / Year
        ========================= -->

        <div class="form-group">

          <label
            for="sessionYear"
            class="label"
          >
            Session / Year
            <span class="required">*</span>
          </label>


          <input
            type="text"
            id="sessionYear"
            name="sessionYear"
            required
            autocomplete="off"
            placeholder="e.g. 2023-2024"
            class="input"
          >

        </div>


        <!-- =========================
             File
        ========================= -->

        <div class="form-group full-width">

          <label
            for="file"
            class="label"
          >
            Question Paper File
            <span class="required">*</span>
          </label>


          <input
            type="file"
            id="file"
            name="file"
            required
            accept=".pdf,.jpg,.jpeg,.png,.webp,.gif"
            class="file-input"
          >


          <p class="file-help">
            Accepted formats: PDF, JPG, PNG, WEBP, GIF · Maximum size: 15 MB
          </p>

        </div>


      </div>


      <!-- =========================
           SUBMIT
      ========================= -->

      <button
        type="submit"
        class="submit-button"
      >
        Upload Question Paper
      </button>


      <!-- =========================
           INFO
      ========================= -->

      <div class="info-box">

        <strong>Before uploading:</strong>

        Make sure the course information is correct and the uploaded paper
        is readable. Uploaded papers are publicly accessible to everyone.

      </div>


    </form>

  </main>


  <!-- =========================
       FOOTER
  ========================= -->

  <footer class="footer">

    <div class="container footer-inner">

      <div>

        <div class="footer-brand">
          UniQBank
        </div>

        <div class="footer-text">
          Built by students, for students.
        </div>

      </div>


      <a
        href="/"
        class="footer-link"
      >
        Browse Question Papers
      </a>

    </div>

  </footer>

</body>

</html>