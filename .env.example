# ---- Server ----
PORT=3000
NODE_ENV=development
# Public URL of the frontend (added to the CORS allow-list)
FRONTEND_URL=http://localhost:5173
# Optional extra allowed origins, comma separated
CORS_ORIGINS=

# ---- PostgreSQL ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# SSL defaults to on in production. Set false for a local DB, true to force.
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10

# ---- Admin authentication (REQUIRED; no fallback values) ----
ADMIN_PASSWORD=change-me-to-a-strong-password
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`)
ADMIN_JWT_SECRET=replace-with-a-random-string-of-32-plus-characters

# ---- S3-compatible storage (ElasticLake) ----
ELASTICLAKE_ENDPOINT=https://app.elasticlake.com
ELASTICLAKE_ACCESS_KEY=your_access_key
ELASTICLAKE_SECRET_KEY=your_secret_key
ELASTICLAKE_BUCKET=your_bucket_name

# ---- AI assistant (optional; endpoint returns 503 if unset) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
