# Copy this file to .env and fill in your own values.

# Local example: postgresql://postgres:password@localhost:5432/uniqbank
# Render/Railway: they inject DATABASE_URL automatically once you attach a Postgres addon.
DATABASE_URL=postgresql://user:password@localhost:5432/uniqbank

PORT=3000
NODE_ENV=development

# Google Drive Storage (Shared folder ID where files will be stored)
GOOGLE_DRIVE_FOLDER_ID=

# Option A: Google Cloud Service Account (Recommended for Render)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Option B: OAuth2 Refresh Token (Alternative for personal account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
